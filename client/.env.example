# In dev, leave this unset — vite.config.js proxies /api to your local
# server (see the `server.proxy` block) so a relative "/api" URL works.
#
# In production, the client is on Vercel and the server is on Render,
# which are different origins, so the client needs the server's full
# URL to call it. Set this in Vercel's project environment variables:
# VITE_API_URL=https://your-escrit-server.onrender.com
VITE_API_URL=

# Public Google OAuth Client ID (not secret — this exact value also
# ends up in the compiled client bundle). Powers the "Continue with
# Google" button. Create one at
# https://console.cloud.google.com/apis/credentials and add your dev
# and prod origins under "Authorized JavaScript origins". Leave blank
# to hide the button.
VITE_GOOGLE_CLIENT_ID=

# Optional demo accounts shown as one-click buttons on the login page (for hackathon
# judges). These are compiled into the public bundle: use throwaway accounts only.
VITE_DEMO_BUYER_EMAIL=
VITE_DEMO_BUYER_PASSWORD=
VITE_DEMO_SELLER_EMAIL=
VITE_DEMO_SELLER_PASSWORD=
